{
  "name": "jacks-theme",
  "displayName": "Jack's Theme",
  "description": "A VS Code theme collection with carbon, TTY, graphite, silver, and draft-inspired editor options.",
  "version": "0.6.11",
  "publisher": "jackrobertscott",
  "type": "module",
  "license": "MIT",
  "icon": "assets/icon.png",
  "keywords": [
    "theme",
    "dark",
    "color-theme",
    "vscode-theme",
    "carbon",
    "tty",
    "unix",
    "terminal",
    "phosphor",
    "crt",
    "retro",
    "hacker",
    "graphite",
    "draft",
    "light",
    "paper",
    "silver",
    "gray",
    "grey"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/badge/version-0.6.11-d8b84d?style=flat-square",
      "href": "https://marketplace.visualstudio.com/items?itemName=jackrobertscott.jacks-theme",
      "description": "Jack's Theme extension version"
    },
    {
      "url": "https://img.shields.io/badge/VS%20Code-%5E1.90.0-67b9ff?style=flat-square",
      "href": "https://code.visualstudio.com/api/working-with-extensions/publishing-extension#visual-studio-code-compatibility",
      "description": "Compatible VS Code engine range"
    },
    {
      "url": "https://img.shields.io/badge/license-MIT-76c26e?style=flat-square",
      "href": "https://opensource.org/license/mit",
      "description": "MIT license"
    }
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Jack's Carbon Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/jacks-carbon-theme-color-theme.json"
      },
      {
        "label": "Jack's TTY Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/jacks-tty-theme-color-theme.json"
      },
      {
        "label": "Jack's Graphite Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/jacks-graphite-theme-color-theme.json"
      },
      {
        "label": "Jack's Silver Theme",
        "uiTheme": "vs",
        "path": "./themes/jacks-silver-theme-color-theme.json"
      },
      {
        "label": "Jack's Draft Theme",
        "uiTheme": "vs",
        "path": "./themes/jacks-draft-theme-color-theme.json"
      }
    ]
  },
  "scripts": {
    "generate": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc && node out/generate-theme.js",
    "validate:themes": "node scripts/validate-theme-schema.mjs",
    "vscode:prepublish": "npm run generate",
    "package": "vsce package --allow-missing-repository",
    "finish": "bash scripts/finish-work.sh",
    "publish:marketplace": "bash scripts/publish-marketplace.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackrobertscott/vscode-jacks-theme.git"
  },
  "bugs": {
    "url": "https://github.com/jackrobertscott/vscode-jacks-theme/issues"
  },
  "homepage": "https://github.com/jackrobertscott/vscode-jacks-theme#readme"
}
