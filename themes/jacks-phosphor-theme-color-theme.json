  "tokenColors": [
    {
      "name": "Source text",
      "scope": [
        "source",
        "meta.embedded",
        "text.html.markdown",
        "meta.jsx.children"
      ],
      "settings": {
        "foreground": "#b6ff9c"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4f8a4f"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#4f8a4f"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffb84d"
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "storage.modifier.async",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#ffb84d"
      }
    },
    {
      "name": "Declaration keywords",
      "scope": [
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#d6ff7a"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#8fcf86"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#7cff63"
      }
    },
    {
      "name": "Template strings",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#7cff63"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7cff63"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#d6ff7a"
      }
    },
    {
      "name": "Booleans and nullish values",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#d6ff7a"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#35d7ff"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "support.function.dom"
      ],
      "settings": {
        "foreground": "#35d7ff"
      }
    },
    {
      "name": "Classes and constructors",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
