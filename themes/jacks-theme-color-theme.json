  "tokenColors": [
    {
      "name": "Source text",
      "scope": [
        "source",
        "meta.embedded",
        "text.html.markdown"
      ],
      "settings": {
        "foreground": "#a5bfca"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b887c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#728e99",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b5a3fe"
      }
    },
    {
      "name": "TypeScript imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "storage.modifier.async"
      ],
      "settings": {
        "foreground": "#bc87e2"
      }
    },
    {
      "name": "Storage and declarations",
      "scope": [
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#b5a3fe"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#3dd1e9"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#7dc479"
      }
    },
    {
      "name": "Template strings",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#5fd397"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#20cbba"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#fd8981"
      }
    },
    {
      "name": "Booleans and nullish values",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#f89854"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#3dd1e9"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "support.function.dom",
        "meta.method-call",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#69b7f5"
      }
    },
    {
      "name": "Classes and constructors",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#f0bb52"
      }
    },
    {
      "name": "Interfaces, aliases, and type parameters",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type",
        "entity.name.type.module",
        "support.type.primitive",
        "meta.type.parameters"
      ],
      "settings": {
        "foreground": "#d0b958"
      }
    },
    {
      "name": "Object keys and properties",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.member",
        "meta.property.object"
      ],
      "settings": {
        "foreground": "#cce0e9"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#e784b8"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#a5bfca"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#e784b8"
      }
    },
    {
      "name": "JSX components",
      "scope": [
        "entity.name.tag.tsx",
        "support.class.component.tsx",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f0bb52"
      }
    },
    {
      "name": "JSX punctuation and attributes",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#20cbba"
      }
    },
    {
      "name": "HTML and XML tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#3dd1e9"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#f0bb52"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#69b7f5"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#3dd1e9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5fd397"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#b5a3fe",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f0bb52",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Inserted content",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#7dc479"
      }
    },
    {
      "name": "Deleted content",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#f1696d"
      }
    },
    {
      "name": "Changed content",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#69b7f5"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f1696d"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#728e99"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#20cbba",
    "type": "#d0b958",
    "class": "#f0bb52",
    "enum": "#f0bb52",
    "interface": "#d0b958",
    "struct": "#f0bb52",
    "typeParameter": "#b5a3fe",
    "parameter": "#e784b8",
    "variable": "#a5bfca",
    "property": "#cce0e9",
    "enumMember": "#fd8981",
    "event": "#e784b8",
    "function": "#3dd1e9",
    "method": "#69b7f5",
    "macro": "#b5a3fe",
    "keyword": "#b5a3fe",
    "modifier": "#bc87e2",
    "comment": {
      "foreground": "#5b887c",
      "fontStyle": "italic"
    },
    "string": "#7dc479",
    "number": "#fd8981",
    "regexp": "#20cbba",
    "operator": "#3dd1e9",
    "decorator": "#e784b8",
    "variable.readonly": "#f89854",
    "property.readonly": "#d0b958",
    "parameter.declaration": "#e784b8",
    "function.declaration": "#3dd1e9",
    "method.declaration": "#69b7f5",
