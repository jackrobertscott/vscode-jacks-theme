  "tokenColors": [
    {
      "name": "Source text",
      "scope": [
        "source",
        "meta.embedded",
        "text.html.markdown"
      ],
      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8397ad"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#8397ad"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e6ac60"
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "storage.modifier.async",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#e6ac60"
      }
    },
    {
      "name": "Storage and declarations",
      "scope": [
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#e6ac60"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#8c8c8c"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#8cbf93"
      }
    },
    {
      "name": "Template strings",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#8cbf93"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#8cbf93"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#e6ac60"
      }
    },
    {
      "name": "Booleans and nullish values",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#e6ac60"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#77b7d1"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "support.function.dom",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#77b7d1"
      }
    },
    {
      "name": "Classes and constructors",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#77b7d1"
      }
    },
    {
      "name": "Interfaces, aliases, and type parameters",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "support.type.primitive",
        "meta.type.parameters",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#77b7d1"
      }
    },
    {
      "name": "Object keys and properties",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.member",
        "meta.property.object",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "entity.name.variable",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
