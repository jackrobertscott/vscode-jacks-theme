        "foreground": "#75cbff"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d7d7d7"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f6f6f6"
      }
    },
    {
      "name": "Inserted content",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#8eda99"
      }
    },
    {
      "name": "Deleted content",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
