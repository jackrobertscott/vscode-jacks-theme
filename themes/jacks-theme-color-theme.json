  "tokenColors": [
    {
      "name": "Source text",
      "scope": [
        "source",
        "meta.embedded",
        "text.html.markdown"
      ],
      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7fa378"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#7fa378"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff9f35"
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "storage.modifier.async",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#ff9f35"
      }
    },
    {
      "name": "Storage and declarations",
      "scope": [
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#e7cf63"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#ff9f35"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9fbd72"
      }
    },
    {
      "name": "Template strings",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#9fbd72"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#9fbd72"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#ff7f4f"
      }
    },
    {
      "name": "Booleans and nullish values",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#ff7f4f"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#f0f0f0"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "support.function.dom",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#69b8cf"
      }
    },
    {
      "name": "Classes and constructors",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e7cf63"
      }
    },
    {
      "name": "Interfaces, aliases, and type parameters",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "support.type.primitive",
        "meta.type.parameters",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#ff9f35"
      }
    },
    {
      "name": "Object keys and properties",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.member",
        "meta.property.object",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#69b8cf"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#c49be5"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "entity.name.variable",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#e7cf63"
      }
    },
    {
      "name": "JSX components",
      "scope": [
        "entity.name.tag.tsx",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#e7cf63"
      }
    },
    {
      "name": "JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ff9f35"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#8c8c8c"
      }
    },
    {
      "name": "HTML and XML tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#e7cf63"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#e7cf63"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
