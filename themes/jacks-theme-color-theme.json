      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#ff9f35"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ff9f35"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e7cf63"
      }
    },
    {
      "name": "Inserted content",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#9fbd72"
      }
    },
    {
      "name": "Deleted content",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#f05b5f"
      }
    },
    {
      "name": "Changed content",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e7cf63"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f05b5f"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#8c8c8c"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#ff9f35",
    "type": "#ff9f35",
