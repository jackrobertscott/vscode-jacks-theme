  "tokenColors": [
    {
      "name": "Source text",
      "scope": [
        "source",
        "meta.embedded",
        "text.html.markdown",
        "meta.jsx.children"
      ],
      "settings": {
        "foreground": "#c8f7b5"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#668a64"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#668a64"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d4a65f"
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "storage.modifier.async",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#d4a65f"
      }
    },
    {
      "name": "Declaration keywords",
      "scope": [
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#dfd071"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#8fbd8b"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#8ee972"
      }
    },
    {
      "name": "Template strings",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#8ee972"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#8ee972"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#dfd071"
      }
    },
    {
      "name": "Booleans and nullish values",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#dfd071"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#7dc8d8"
      }
    },
    {
      "name": "Methods",
      "scope": [
